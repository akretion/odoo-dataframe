<odoo>
    <record id="field_log_list" model="ir.ui.view">
        <field name="model">field.log</field>
        <field name="arch" type="xml">
            <list expand="1" multi_edit="1">
                <header>
                    <button name="get_res_id" type="object" string="res_id" />
                </header>
                <field name="info" />
                <field name="data" optional="hide" />
                <field name="model_id" />
                <field name="create_date" optional="hide" />
                <field name="res_id" optional="hide" />
                <field name="ref_model" optional="hide" />
                <field name="field_id" optional="hide" />
                <field name="kind" optional="hide" />
                <button
                    name="goto_current_erp"
                    type="object"
                    class="fa fa-arrow-circle-o-right"
                    title="Current Odoo record"
                    invisible="not res_id or not ref_model"
                />
            </list>
        </field>
    </record>

    <record id="field_log_search" model="ir.ui.view">
        <field name="model">field.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="info" />
                <field name="model" />
                <field name="kind" />
                <group string="Group By">
                    <filter
                        string="Model"
                        name="model_gb"
                        context="{'group_by': 'model'}"
                    />
                    <filter
                        string="Kind"
                        name="kind_gb"
                        context="{'group_by': 'kind'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="field_log_action" model="ir.actions.act_window">
        <field name="name">Field Logs</field>
        <field name="res_model">field.log</field>
        <field name="view_mode">list,form</field>
        <field
            name="context"
        >{"search_default_model_gb": 1, "search_default_kind_gb": 1}</field>
    </record>
</odoo>
