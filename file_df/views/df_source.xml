<odoo>
    <record id="df_source_list" model="ir.ui.view">
        <field name="model">df.source</field>
        <field name="inherit_id" ref="df_source.df_source_list" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state']" position="before">
                <field name="map_id" />
                <field name="comment_short" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="df_source_form" model="ir.ui.view">
        <field name="model">df.source</field>
        <field name="inherit_id" ref="df_source.df_source_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='count']" position="before">
                <field name="map_id" readonly="state == 'done'" />
            </xpath>
            <xpath expr="//group[last()]" position="after">
                <group col="1">
                    <field name="comment" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
