<odoo>
    <record id="df_source_form" model="ir.ui.view">
        <field name="model">df.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <field name="state" widget="statusbar" />
                    </header>
                    <group>
                        <group>
                            <field name="model" />
                            <field name="file" readonly="state == 'done'" />
                            <field
                                name="short_name"
                                string="Name"
                                readonly="state == 'done'"
                            />
                        </group>
                        <group name="right">
                            <field name="name" optional="hide" />
                            <field name="filename" invisible="1" />
                            <field name="count" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="df_source_list" model="ir.ui.view">
        <field name="model">df.source</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="state == 'failed'">
                <header>
                    <button
                        name="save_in_xlsx"
                        type="object"
                        class="fa fa-table"
                        title="Export in spreadsheet"
                    />
                </header>
                <field name="sequence" widget="handle" />
                <field name="id" optional="hide" />
                <field name="display_name" optional="hide" />
                <field name="short_name" string="Name" />
                <field name="name" column_invisible="1" />
                <field name="model" />
                <button
                    name="start"
                    title="Start process"
                    help="Start ---"
                    class="fa fa-play"
                    type="object"
                    invisible="state == 'done'"
                />
                <field name="time" optional="show" />
                <field name="count" optional="show" />
                <button
                    name="goto_records"
                    type="object"
                    class="fa fa-arrow-circle-right"
                    title="Go to related records"
                    invisible="not linked"
                />
                <field name="linked" column_invisible="1" />
                <button
                    type="object"
                    name="reset_process"
                    class="fa fa-eraser"
                    invisible="not linked"
                    title="Not yet implemented in this module"
                />
                <field name="state" />
                <field
                    name="file"
                    widget="binary"
                    filename="filename"
                    options="{'accepted_file_extensions': '.xlsx'}"
                />
                <field name="filename" column_invisible="1" />
            </list>
        </field>
    </record>

    <record id="df_source_search" model="ir.ui.view">
        <field name="model">df.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="short_name" />
                <group expand="0" string="Group By">
                    <filter
                        string="Model"
                        name="model"
                        context="{'group_by': 'model'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="df_source_action" model="ir.actions.act_window">
        <field name="name">Data sources</field>
        <field name="res_model">df.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
        <field name="path">df-source</field>
    </record>
</odoo>
