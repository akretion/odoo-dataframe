<odoo>
    <record id="matching_field_list" model="ir.ui.view">
        <field name="model">matching.field</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="model_id" />
                <field
                    name="field_ids"
                    domain="[('model_id','=', model_id)]"
                    widget="many2many_tags"
                />
            </list>
        </field>
    </record>

    <record id="matching_field_search" model="ir.ui.view">
        <field name="model">matching.field</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="model_id"
                    string="Model"
                    filter_domain="[('model_id', 'ilike', self)]"
                />
                <field
                    name="field_ids"
                    string="Field"
                    filter_domain="[('field_ids', 'ilike', self)]"
                />
                <filter
                    name="model_id"
                    string="Model"
                    domain="[]"
                    context="{'group_by' : 'model_id'}"
                />
            </search>
        </field>
    </record>

    <record id="matching_field_action" model="ir.actions.act_window">
        <field name="name">Matching Fields</field>
        <field name="res_model">matching.field</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
